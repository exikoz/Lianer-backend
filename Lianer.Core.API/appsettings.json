{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Gemini": {
    "ApiKey": ""
  },
  
  "Auth": {
    "Cookies": {
      "AccessCookieName": "__Host-lianer-access",
      "RefreshCookieName": "__Host-lianer-refresh",
      "CsrfCookieName": "__Host-lianer-csrf",

      "CsrfHeaderName": "X-CSRF-TOKEN",

      "AccessTokenMinutes": 15,
      "RefreshTokenDays": 7,

      "Secure": true,
      "SameSite": "None",
      "Path": "/",
      "IsEssential": true
    }
  }
}
